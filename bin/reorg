#!/usr/bin/env node
// reorg -- plan a directory reorganization in the browser, apply it with an undo script.

import { existsSync, mkdtempSync, readFileSync, statSync } from 'node:fs';
import { join, resolve as resolvePath } from 'node:path';
import { tmpdir } from 'node:os';
import { pathToFileURL } from 'node:url';
import { spawn } from 'node:child_process';
import { createReorgServer } from '../src/server.js';
import { scan, readGitignore, formatBytes } from '../src/scan.js';
import { loadPlan, listUndoScripts, stateDir, planPath, clearAppliedPlan } from '../src/state.js';
import { resolve as resolvePlan, describeOp } from '../src/plan.js';
import { apply } from '../src/apply.js';
import { summarize, emitPrompts, ingestSummaries, DEFAULT_MODEL } from '../src/summarize.js';
import { analyze, ranked } from '../src/signals.js';
import { writeStaticPlanner } from '../src/static.js';
import { parsePlanExport } from '../web/lib/plan-file.js';

const HELP = `reorg -- plan a directory reorganization, then apply it safely.

USAGE
  reorg [dir]                    scan dir (default .), serve the planner, open a browser
  reorg [dir] --static           write one self-contained planner page instead
  reorg plan [dir]               print the current plan as operations, then exit
  reorg apply [dir]              dry run: print what would happen, change nothing
  reorg apply [dir] --yes        actually apply, writing an undo script first
  reorg apply --plan FILE        use a plan exported by a static planner
  reorg undo [dir]               run the most recent undo script
  reorg summarize [dir]          one-line AI summary per file (see SUMMARIES)
  reorg triage [dir]             rank likely-disposable entries (see TRIAGE)
  reorg status [dir]             what is planned, what is applied, what can be undone

OPTIONS
  -p, --port N       listen on N (default: first free port from 7777)
  --no-open          do not launch a browser
  -s, --static       write and open a self-contained HTML planner, with no server
  -o, --output FILE  with --static: write FILE instead of a temporary page
  --plan FILE        with 'apply': read an exported plan; use - for stdin
  --allow-apply      let the browser apply the plan; off by default, so the web UI
                     can only dry-run and the destructive step stays in the terminal
  -y, --yes          with 'apply': execute instead of dry-running
  --all              descend into everything, ignoring the collapse rules
  --no-hidden        skip dotfiles entirely
  --max-nodes N      stop scanning past N entries (default 20000)
  --collapse-over N  show any dir holding more than N files as one row (default 400)
  --depth N          stop descending past depth N (default 24)
  --emit-prompts     with 'summarize': write a prompt pack for your coding agent
  --ingest           with 'summarize': merge an agent-filled summaries.json
  --model ID         with 'summarize': model to call (default ${DEFAULT_MODEL})
  --force            with 'summarize': re-summarize files that already have one
  --limit N          with 'triage': show at most N candidates (default 30)
  -h, --help         this text

SUMMARIES
  Two paths, both optional:
    reorg summarize --emit-prompts   writes .reorg/summarize.md + summaries.json.
                                     Point any coding agent at it -- no API key,
                                     no cost. Then: reorg summarize --ingest
    ANTHROPIC_API_KEY=... reorg summarize   calls the API directly and fills them in.

TRIAGE
  'reorg triage' ranks entries that look disposable and says why, so you can
  decide rather than scroll. It reads NAMES and structure, not age: measured
  against real scratch directories, "backup"/"dryrun"/"tmp" in a name and an
  archive still sitting beside its unpacked copy predict junk well, while mtime
  predicts almost nothing -- the obvious junk is often days old and the
  deliberate keepers are often years old. Age is shown for context, never scored.
  Triage only ever prints; marking anything for trash stays your decision.

SAFETY
  Nothing is deleted. "Trash" moves into .reorg/trash/<run>/, recoverable by the
  undo script. Every apply writes .reorg/undo-<run>.sh before it starts, and
  aborts entirely if the tree changed since the scan. A live plan lives in
  .reorg/plan.json; a static plan stays in the page until you export it.
`;

function parseArgs(argv) {
  const opts = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const value = () => {
      const next = argv[i + 1];
      if (next === undefined || (next.startsWith('-') && next !== '-')) {
        console.error(`reorg: ${a} requires a value\nTry: reorg --help`);
        process.exit(2);
      }
      i++;
      return next;
    };
    if (a === '-h' || a === '--help') opts.help = true;
    else if (a === '--no-open') opts.open = false;
    else if (a === '--static' || a === '-s') opts.static = true;
    else if (a === '--allow-apply') opts.allowApply = true;
    else if (a === '--yes' || a === '-y') opts.yes = true;
    else if (a === '--all') opts.all = true;
    else if (a === '--no-hidden') opts.hidden = false;
    else if (a === '--emit-prompts') opts.emitPrompts = true;
    else if (a === '--ingest') opts.ingest = true;
    else if (a === '--force') opts.force = true;
    else if (a === '--json') opts.json = true;
    else if (a === '--output' || a === '-o') opts.output = value();
    else if (a === '--plan') opts.planInput = value();
    else if (a === '--port' || a === '-p') opts.port = parseInt(value(), 10);
    else if (a === '--max-nodes') opts.maxNodes = parseInt(value(), 10);
    else if (a === '--collapse-over') opts.collapseOver = parseInt(value(), 10);
    else if (a === '--depth') opts.maxDepth = parseInt(value(), 10);
    else if (a === '--model') opts.model = value();
    else if (a === '--limit') opts.limit = parseInt(value(), 10);
    else if (a.startsWith('-')) {
      console.error(`reorg: unknown option ${a}\nTry: reorg --help`);
      process.exit(2);
    } else opts._.push(a);
  }
  return opts;
}

const KNOWN = new Set(['plan', 'apply', 'undo', 'summarize', 'triage', 'status', 'serve']);

function resolveRoot(candidate) {
  const root = resolvePath(candidate || '.');
  if (!existsSync(root)) {
    console.error(`reorg: ${root} does not exist`);
    process.exit(1);
  }
  if (!statSync(root).isDirectory()) {
    console.error(`reorg: ${root} is not a directory`);
    process.exit(1);
  }
  return root;
}

function scanOpts(opts) {
  return {
    all: opts.all,
    hidden: opts.hidden,
    maxNodes: opts.maxNodes,
    maxDepth: opts.maxDepth,
    collapseOver: opts.collapseOver,
  };
}

function readPlanInput(inputPath) {
  if (!inputPath) throw new Error('--plan requires a file path, or - for stdin');
  let text;
  try {
    text = readFileSync(inputPath === '-' ? 0 : resolvePath(inputPath), 'utf8');
  } catch (e) {
    const label = inputPath === '-' ? 'stdin' : resolvePath(inputPath);
    throw new Error(`could not read plan from ${label} (${e.message})`);
  }
  let parsed;
  try {
    parsed = JSON.parse(text);
  } catch (e) {
    throw new Error(`plan input is not valid JSON (${e.message})`);
  }
  return parsePlanExport(parsed);
}

function openBrowser(url) {
  const cmd =
    process.platform === 'darwin' ? 'open' : process.platform === 'win32' ? 'start' : 'xdg-open';
  try {
    spawn(cmd, [url], { stdio: 'ignore', detached: true, shell: process.platform === 'win32' }).unref();
  } catch {
    /* headless or no handler; the URL is already printed */
  }
}

function listen(server, port, host = '127.0.0.1', tries = 20) {
  return new Promise((done, fail) => {
    const attempt = (p, left) => {
      const onError = (e) => {
        if (e.code === 'EADDRINUSE' && left > 0) {
          server.removeListener('error', onError);
          attempt(p + 1, left - 1);
        } else fail(e);
      };
      server.once('error', onError);
      server.listen(p, host, () => {
        server.removeListener('error', onError);
        done(p);
      });
    };
    attempt(port, tries);
  });
}

function printOps(ops, stats) {
  if (!ops.length) {
    console.log('Nothing planned yet. Drag things around in the planner first.');
    return;
  }
  for (const op of ops) console.log(`  ${describeOp(op)}`);
  const bits = [];
  if (stats.mkdir) bits.push(`${stats.mkdir} new dir${stats.mkdir === 1 ? '' : 's'}`);
  if (stats.move) bits.push(`${stats.move} move${stats.move === 1 ? '' : 's'}`);
  if (stats.trash) {
    const size = stats.trashBytes ? ` (${formatBytes(stats.trashBytes)})` : '';
    bits.push(`${stats.trash} to trash${size}`);
  }
  console.log(`\n${bits.join(', ')}.`);
}

function loadResolved(root, opts, imported = null) {
  const s = imported && imported.scan ? { ...imported.scan, root } : scan(root, scanOpts(opts));
  const plan = imported ? imported.plan : loadPlan(root);
  const resolved = resolvePlan(s, plan);
  if (resolved.problems.length) {
    console.error('This plan cannot be applied as-is:\n');
    for (const p of resolved.problems) console.error(`  - ${p.message}`);
    console.error('\nFix it in the planner, then try again.');
    process.exit(1);
  }
  return { ...resolved, plan };
}

async function main() {
  const argv = process.argv.slice(2);
  const opts = parseArgs(argv);
  if (opts.help) {
    console.log(HELP);
    return;
  }

  const [first, second] = opts._;
  const cmd = KNOWN.has(first) ? first : 'serve';
  if (opts.planInput && cmd !== 'apply') {
    throw new Error('--plan can only be used with reorg apply');
  }
  if (opts.output && !opts.static) {
    throw new Error('--output can only be used with --static');
  }
  if (opts.static && cmd !== 'serve') {
    throw new Error('--static cannot be combined with another command');
  }
  if (opts.static && opts.allowApply) {
    throw new Error('--allow-apply is unavailable with --static');
  }

  const imported = opts.planInput ? readPlanInput(opts.planInput) : null;
  const rootArg = KNOWN.has(first) ? second : first;
  const root = resolveRoot(rootArg || (imported && imported.sourceRoot) || '.');

  // ---- plan --------------------------------------------------------------
  if (cmd === 'plan') {
    const { ops, stats } = loadResolved(root, opts);
    printOps(ops, stats);
    return;
  }

  // ---- apply -------------------------------------------------------------
  if (cmd === 'apply') {
    const { ops, stats, plan } = loadResolved(root, opts, imported);
    if (!ops.length) {
      console.log('Nothing to apply.');
      return;
    }
    if (!opts.yes) {
      const checked = apply(root, ops, { dryRun: true });
      if (checked.problems.length) {
        console.error('This plan no longer matches the directory:\n');
        for (const p of checked.problems) console.error(`  - ${p}`);
        console.error('\nNothing was changed. Regenerate the static planner or rescan the live planner.');
        process.exit(1);
      }
      console.log(`DRY RUN -- nothing will change. ${ops.length} operation(s):\n`);
      printOps(ops, stats);
      console.log('\nRun again with --yes to apply. An undo script is written first.');
      return;
    }
    console.log(`Applying ${ops.length} operation(s) in ${root}:\n`);
    const res = apply(root, ops, { dryRun: false, onLog: (l) => console.log(l) });
    if (res.problems.length) {
      console.error('\nAborted before making any change:\n');
      for (const p of res.problems) console.error(`  - ${p}`);
      console.error('\nThe tree changed since the scan. Rescan in the planner and retry.');
      process.exit(1);
    }
    // The plan has been realized, so retire it. Leaving it would make the next
    // resolve see created folders both on disk and as pending, and report a
    // collision that does not exist.
    clearAppliedPlan(root, plan);
    console.log(`\nDone: ${res.applied} operation(s).`);
    console.log(`Undo with:  reorg undo ${root === process.cwd() ? '' : root}`.trimEnd());
    console.log(`         or: bash ${res.undoPath}`);
    if (res.trashRoot && stats.trash) console.log(`Trashed items are at: ${res.trashRoot}`);
    return;
  }

  // ---- undo --------------------------------------------------------------
  if (cmd === 'undo') {
    const scripts = listUndoScripts(root);
    if (!scripts.length) {
      console.error(`reorg: no undo scripts in ${stateDir(root)}`);
      process.exit(1);
    }
    const latest = resolvePath(stateDir(root), scripts[0]);
    console.log(`Running ${latest}\n`);
    const child = spawn('bash', [latest], { stdio: 'inherit' });
    child.on('exit', (code) => process.exit(code ?? 0));
    return;
  }

  // ---- summarize ---------------------------------------------------------
  if (cmd === 'summarize') {
    if (opts.ingest) {
      const { added, total } = ingestSummaries(root);
      console.log(`Merged ${added} summar${added === 1 ? 'y' : 'ies'} (${total} total).`);
      console.log('Reload the planner to see them inline.');
      return;
    }
    const s = scan(root, scanOpts(opts));
    const files = s.nodes.filter((n) => n.kind === 'file').map((n) => n.id);
    if (!files.length) {
      console.log('No files to summarize.');
      return;
    }
    if (opts.emitPrompts || !process.env.ANTHROPIC_API_KEY) {
      const out = await emitPrompts({ root, paths: files, force: opts.force });
      if (!opts.emitPrompts) {
        console.log('ANTHROPIC_API_KEY is not set, so falling back to the agent path.\n');
      }
      console.log(`Wrote a prompt pack for ${out.count} file(s):`);
      console.log(`  ${out.promptPath}`);
      console.log(`  ${out.outPath}   <- the file to fill in`);
      console.log('\nNext: point your coding agent at that markdown file, then run');
      console.log('  reorg summarize --ingest');
      return;
    }
    console.log(`Summarizing with ${opts.model || DEFAULT_MODEL}...`);
    const res = await summarize({
      root,
      paths: files,
      model: opts.model,
      force: opts.force,
      onProgress: ({ done, total }) => {
        if (total) process.stderr.write(`\r  ${done}/${total} files`);
      },
    });
    process.stderr.write('\n');
    if (res.error) {
      console.error(`reorg: ${res.error}`);
      process.exit(1);
    }
    const n = Object.keys(res.summaries).length;
    console.log(`Wrote ${n} summar${n === 1 ? 'y' : 'ies'} to ${planPath(root)}`);
    if (res.usage) {
      console.log(`Tokens: ${res.usage.input_tokens} in, ${res.usage.output_tokens} out`);
    }
    if (res.skipped.length) console.log(`Skipped ${res.skipped.length} (binary, empty, or missing).`);
    return;
  }

  // ---- triage ------------------------------------------------------------
  if (cmd === 'triage') {
    const s = scan(root, scanOpts(opts));
    const analysis = analyze(s, { bulkOver: opts.collapseOver });
    const byId = new Map(s.nodes.map((n) => [n.id, n]));
    const list = ranked(analysis, opts.limit || 30);

    if (!list.length) {
      console.log('Nothing here looks obviously disposable.');
      return;
    }
    console.log(`${analysis.size} candidate(s) in ${root}, strongest first.`);
    console.log('Ranked by name and structure. Age is shown for context only.\n');

    // Explain each reason once, in a legend, rather than repeating the same
    // sentence under every row -- at 30 candidates that is most of the output.
    const seen = new Map();
    for (const c of list) for (const sig of c.signals) if (!seen.has(sig.id)) seen.set(sig.id, sig.why);

    for (const c of list) {
      const n = byId.get(c.id);
      const age = n && n.mtime ? `${Math.round((Date.now() - n.mtime) / 86400000)}d` : '';
      console.log(`  ${formatBytes(c.bytes).padStart(8)}  ${age.padStart(5)}  ${c.id}`);
      console.log(`            ${c.signals.map((sig) => sig.label).join('  |  ')}`);
    }

    console.log('\nWhy those were flagged:');
    for (const why of new Set(seen.values())) console.log(`  - ${why}`);
    const total = list.reduce((a, c) => a + (c.bytes || 0), 0);
    console.log(`\n${formatBytes(total)} across those ${list.length}.`);
    console.log('Nothing was changed. Open the planner to act on any of it:');
    console.log(`  reorg ${root === process.cwd() ? '' : root}`.trimEnd());
    return;
  }

  // ---- status ------------------------------------------------------------
  if (cmd === 'status') {
    const s = scan(root, scanOpts(opts));
    const plan = loadPlan(root);
    const { ops, problems, stats } = resolvePlan(s, plan);
    console.log(`Root:     ${root}`);
    console.log(
      `Scanned:  ${s.counts.nodes} entries (${s.counts.dirs} dirs, ${s.counts.files} files, ${formatBytes(
        s.counts.bytes
      )})${s.truncated ? ' [truncated -- raise --max-nodes]' : ''}`
    );
    console.log(`Git:      ${s.git ? 'yes' : 'no'}`);
    if (s.collapsed && s.collapsed.length) {
      // Say what was not expanded. "Scanned N entries" alone reads as complete
      // coverage when the biggest things in the directory were summarized away.
      const top = s.collapsed.slice(0, 5);
      console.log(`Collapsed: ${s.collapsed.length} dir(s) shown as a single row:`);
      for (const c of top) {
        console.log(`  ${c.id}  (${c.files} files, ${formatBytes(c.bytes)})`);
      }
      if (s.collapsed.length > top.length) {
        console.log(`  ...and ${s.collapsed.length - top.length} more. Use --all to descend.`);
      }
    }
    console.log(`Plan:     ${plan.savedAt ? `saved ${plan.savedAt}` : 'none yet'}`);
    console.log(`Pending:  ${ops.length} operation(s), ${stats.touched} node(s) touched`);
    if (problems.length) {
      console.log(`Problems: ${problems.length}`);
      for (const p of problems) console.log(`  - ${p.message}`);
    }
    const undos = listUndoScripts(root);
    console.log(`Undo:     ${undos.length ? `${undos.length} script(s), latest ${undos[0]}` : 'none'}`);
    const summaries = Object.keys(plan.summaries || {}).length;
    console.log(`Summaries: ${summaries || 'none'}`);
    return;
  }

  // ---- static planner ----------------------------------------------------
  if (opts.static) {
    const initial = scan(root, scanOpts(opts));
    const output = opts.output
      ? resolvePath(opts.output)
      : join(mkdtempSync(join(tmpdir(), 'reorg-static-')), 'planner.html');
    const result = writeStaticPlanner(output, {
      root,
      scan: initial,
      plan: loadPlan(root),
      gitignore: readGitignore(root),
      undoScripts: listUndoScripts(root),
    });
    const url = pathToFileURL(output).href;

    console.log(`reorg  ${root}`);
    console.log(
      `       ${initial.counts.nodes} entries, ${formatBytes(initial.counts.bytes)}, static snapshot`
    );
    console.log(`\n  ${output}\n`);
    if (result.previewStats.omitted) {
      console.log(
        `Embedded ${result.previewStats.included} file preview(s); ${result.previewStats.omitted} omitted by the page size limit.`
      );
    }
    console.log('Export the finished plan from Review, then dry-run it with:');
    console.log('  reorg apply --plan <path-to-reorg-plan.json>\n');
    if (opts.open !== false) openBrowser(url);
    return;
  }

  // ---- serve (default) ---------------------------------------------------
  const { server, token, scan: initial } = createReorgServer({
    root,
    allowApply: !!opts.allowApply,
  });
  const port = await listen(server, Number.isFinite(opts.port) ? opts.port : 7777);
  const url = `http://127.0.0.1:${port}/?token=${token}`;

  console.log(`reorg  ${root}`);
  console.log(
    `       ${initial.counts.nodes} entries, ${formatBytes(initial.counts.bytes)}${
      initial.git ? ', git-aware' : ''
    }${initial.truncated ? ' (truncated -- raise --max-nodes)' : ''}`
  );
  console.log(`\n  ${url}\n`);
  if (!opts.allowApply) {
    console.log('The browser can plan and dry-run only. To apply:');
    console.log(`  reorg apply ${root === process.cwd() ? '' : root} --yes`.replace(/\s+/g, ' '));
    console.log('Or restart with --allow-apply to enable the Apply button.\n');
  }
  console.log('Ctrl-C to stop.');
  if (opts.open !== false) openBrowser(url);

  for (const sig of ['SIGINT', 'SIGTERM']) {
    process.on(sig, () => {
      server.close(() => process.exit(0));
      // Don't hang on a wedged keep-alive connection.
      setTimeout(() => process.exit(0), 500).unref();
    });
  }
}

main().catch((e) => {
  console.error(`reorg: ${e.message}`);
  process.exit(1);
});
