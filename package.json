{
  "name": "reorg-cli",
  "version": "1.6.0",
  "description": "Plan directory reorganizations yourself or with an AI agent, collaborate through a live browser plan, and safely apply changes with generated undo scripts.",
  "keywords": [
    "cleanup",
    "reorganize",
    "files",
    "directory",
    "tree",
    "planner",
    "ai",
    "agent",
    "collaboration"
  ],
  "license": "AGPL-3.0-only",
  "author": "j-256",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-256/reorg.git"
  },
  "homepage": "https://github.com/j-256/reorg#readme",
  "bugs": "https://github.com/j-256/reorg/issues",
  "type": "module",
  "bin": {
    "reorg": "bin/reorg"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".agents/skills/reorg/SKILL.md",
    "bin",
    "src",
    "web",
    "README.md",
    "DESIGN.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "scripts": {
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run check:docs-cover && node --test --test-reporter=spec \"test/*.test.js\"",
    "test:ui": "node --test --test-reporter=spec \"test/*.spec.js\"",
    "test:all": "npm test && npm run test:ui",
    "screenshots": "node scripts/screenshots.mjs",
    "preversion": "bash scripts/preversion.sh && npm test",
    "postversion": "git push --atomic origin main v$npm_package_version",
    "retag": "bash scripts/preversion.sh && git tag -f v$npm_package_version && git push origin v$npm_package_version --force"
  },
  "dependencies": {},
  "devDependencies": {
    "axe-core": "^4.10.3",
    "playwright": "^1.61.1"
  }
}
